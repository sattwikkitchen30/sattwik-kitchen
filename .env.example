# Server
PORT=5000
NODE_ENV=production

# MongoDB connection string (use MongoDB Atlas for production)
# Get your connection string from: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/sattwik_kitchen

# Secret for signing JWT tokens (use a long random string in production)
# Generate one at: https://www.random.org/strings/
JWT_SECRET=your_long_random_secret_string_at_least_32_characters
JWT_EXPIRES_IN=7d

# Allowed origins for CORS (comma separated)
# For production, add your Render URL: https://your-app.onrender.com
CORS_ORIGIN=https://your-app.onrender.com

# WhatsApp number used in public-site order messages
WHATSAPP_NUMBER=16725881282

# Business timezone for all date calculations
# Use IANA timezone identifiers: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
BUSINESS_TIMEZONE=America/Vancouver

# ==============================================================================
# Email & Password Reset (SMTP Configuration)
# Required for customer, delivery member, and admin password reset emails.
# ==============================================================================
# Option 1: Standard SMTP (Gmail, SendGrid, Mailgun, Brevo, Resend, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
# For Gmail, generate an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Sattwik Kitchen <no-reply@sattwikkitchen.com>"

# Option 2: Named Service (alternative to SMTP_HOST/SMTP_PORT)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_app_password

# Public base URL of the frontend / application (used to generate password reset links)
APP_BASE_URL=http://localhost:5000

# ==============================================================================
# Automated WhatsApp Delivery Notifications Configuration
# ==============================================================================
# Option 1: Meta WhatsApp Cloud API (Recommended)
# Sign up at: https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_API_TOKEN=your_meta_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# Option 2: Twilio for WhatsApp
# Sign up at: https://www.twilio.com/docs/whatsapp
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Option 3: Custom Gateway / Webhook
# WHATSAPP_GATEWAY_URL=https://your-whatsapp-gateway.com/api/send
# WHATSAPP_GATEWAY_KEY=your_gateway_key

